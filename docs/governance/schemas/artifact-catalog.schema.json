{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmdp.internal/docs/governance/schemas/artifact-catalog.schema.json",
  "title": "FMDP Documentation Artifact Catalog Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "status",
    "owner_role",
    "accountable_role",
    "updated_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
    "doc_id": { "type": "string", "pattern": "^GOV-CAT-ART-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "DEPRECATED"] },
    "owner_role": { "$ref": "#/$defs/roleEnum" },
    "accountable_role": { "$ref": "#/$defs/roleEnum" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "name",
          "purpose",
          "owner_role",
          "accountable_role",
          "template_path",
          "schema_path",
          "scope_levels",
          "applicable_planes",
          "applicable_work_types",
          "preconditions",
          "required_related_artifacts",
          "validation_rules",
          "approval_requirements"
        ],
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 3 },
          "purpose": { "type": "string", "minLength": 10 },
          "owner_role": { "$ref": "#/$defs/roleEnum" },
          "accountable_role": { "$ref": "#/$defs/roleEnum" },
          "template_path": { "type": ["string", "null"] },
          "schema_path": { "type": ["string", "null"] },
          "scope_levels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "applicable_planes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["governance", "platform", "data-plane", "application-plane", "intelligence-plane"]
            }
          },
          "applicable_work_types": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "preconditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_related_artifacts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" }
          },
          "validation_rules": {
            "type": "array",
            "items": { "type": "string", "pattern": "^VAL-[A-Z0-9-]+$" }
          },
          "approval_requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate", "approvers"],
            "properties": {
              "gate": { "type": "string", "pattern": "^QG-[0-9]-[A-Z-]+$" },
              "approvers": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/roleEnum" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "roleEnum": {
      "type": "string",
      "enum": [
        "documentation-architect",
        "business-analyst",
        "system-architect",
        "fullstack-engineer",
        "data-architect",
        "database-architect",
        "ai-engineer",
        "security-architect",
        "qa-lead",
        "devops-sre",
        "documentation-tooling-engineer"
      ]
    }
  }
}
