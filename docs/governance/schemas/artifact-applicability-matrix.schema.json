{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmdp.internal/docs/governance/schemas/artifact-applicability-matrix.schema.json",
  "title": "FMDP Artifact Applicability Matrix Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "status",
    "owner_role",
    "accountable_role",
    "updated_at",
    "applicability_classes",
    "risk_assessment",
    "capability_baseline_by_tier",
    "signal_overrides",
    "plane_overrides",
    "scenario_profiles",
    "non_capability_scope_baselines"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
    "doc_id": { "type": "string", "pattern": "^GOV-CAT-MAT-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "DEPRECATED"] },
    "owner_role": { "type": "string" },
    "accountable_role": { "type": "string" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "applicability_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["code", "meaning"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["REQUIRED", "CONDITIONAL", "RECOMMENDED", "NOT_APPLICABLE_WITH_REASON"]
          },
          "meaning": { "type": "string", "minLength": 5 }
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "required": ["tiers", "assessment_signals"],
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["tier", "description", "default_review_depth"],
            "properties": {
              "tier": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH_CRITICAL"] },
              "description": { "type": "string" },
              "default_review_depth": { "type": "string" }
            }
          }
        },
        "assessment_signals": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["signal", "minimum_tier", "description"],
            "properties": {
              "signal": { "type": "string" },
              "minimum_tier": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH_CRITICAL"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "capability_baseline_by_tier": {
      "type": "object",
      "required": ["LOW", "MEDIUM", "HIGH_CRITICAL"],
      "properties": {
        "LOW": { "$ref": "#/$defs/tierBucket" },
        "MEDIUM": { "$ref": "#/$defs/tierBucket" },
        "HIGH_CRITICAL": { "$ref": "#/$defs/tierBucket" }
      }
    },
    "signal_overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signal", "enforce_minimum_tier", "required_artifacts", "rationale"],
        "properties": {
          "signal": { "type": "string" },
          "enforce_minimum_tier": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH_CRITICAL"] },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" }
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "plane_overrides": {
      "type": "object"
    },
    "scenario_profiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["scenario_id", "description", "expected_tier", "signals"],
        "properties": {
          "scenario_id": { "type": "string" },
          "description": { "type": "string" },
          "expected_tier": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH_CRITICAL"] },
          "signals": { "type": "object" }
        }
      }
    },
    "non_capability_scope_baselines": {
      "type": "object",
      "required": ["platform", "plane", "domain"]
    }
  },
  "$defs": {
    "tierBucket": {
      "type": "object",
      "required": ["REQUIRED", "RECOMMENDED", "CONDITIONAL", "NOT_APPLICABLE_WITH_REASON"],
      "properties": {
        "REQUIRED": { "type": "array", "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" } },
        "RECOMMENDED": { "type": "array", "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" } },
        "CONDITIONAL": { "type": "array", "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" } },
        "NOT_APPLICABLE_WITH_REASON": { "type": "array", "items": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" } }
      }
    }
  }
}
