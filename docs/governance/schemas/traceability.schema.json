{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmdp.internal/docs/governance/schemas/traceability.schema.json",
  "title": "FMDP Capability Traceability Matrix Schema (traceability.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "owner_role",
    "document_status",
    "links"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^2\\.[0-9]+\\.[0-9]+$" },
    "capability_id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" },
    "owner_role": { "type": "string", "minLength": 2 },
    "document_status": { "type": "string", "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "DEPRECATED"] },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "business_need_id",
          "requirement_id",
          "rule_or_use_case_ids",
          "design_doc_ids",
          "contract_paths",
          "implementation_paths",
          "test_case_ids",
          "test_paths",
          "verification_evidence"
        ],
        "properties": {
          "business_need_id": { "type": "string", "pattern": "^BR-[A-Z0-9-]+$" },
          "requirement_id": { "type": "string", "pattern": "^(FR|NFR|SEC)-[A-Z0-9-]+$" },
          "rule_or_use_case_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(RULE|UC)-[A-Z0-9-]+$" }
          },
          "design_doc_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 3 }
          },
          "contract_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "implementation_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "test_case_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TC-[A-Z0-9-]+$" }
          },
          "test_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "verification_evidence": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
