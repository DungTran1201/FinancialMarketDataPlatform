{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fmdp.internal/docs/governance/schemas/document-frontmatter.schema.json",
  "title": "FMDP Documentation V2 Markdown Frontmatter Schema",
  "description": "Validates YAML frontmatter metadata on every Markdown document under docs/.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "doc_id",
    "title",
    "doc_type",
    "plane",
    "scope_level",
    "status",
    "implementation_status",
    "version",
    "owner_role",
    "accountable_role",
    "created_at",
    "updated_at",
    "source_of_truth",
    "related_docs"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "index",
        "architecture",
        "standard",
        "governance",
        "specification",
        "adr",
        "diagram",
        "glossary",
        "template",
        "migration-report"
      ]
    },
    "plane": {
      "type": "string",
      "enum": [
        "governance",
        "platform",
        "data-plane",
        "application-plane",
        "intelligence-plane"
      ]
    },
    "scope_level": {
      "type": "string",
      "enum": [
        "governance",
        "platform",
        "plane",
        "domain",
        "capability",
        "component",
        "use-case"
      ]
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "DEPRECATED"
      ]
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "PLANNED",
        "NOT_IMPLEMENTED",
        "SIMULATED",
        "PARTIALLY_IMPLEMENTED",
        "IMPLEMENTED",
        "VERIFIED",
        "NOT_APPLICABLE"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner_role": {
      "$ref": "#/$defs/roleEnum"
    },
    "accountable_role": {
      "$ref": "#/$defs/roleEnum"
    },
    "created_at": {
      "$ref": "#/$defs/isoDate"
    },
    "updated_at": {
      "$ref": "#/$defs/isoDate"
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_authoritative",
        "authoritative_source"
      ],
      "properties": {
        "is_authoritative": {
          "type": "boolean"
        },
        "authoritative_source": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "is_authoritative": {
            "const": false
          }
        },
        "required": [
          "is_authoritative"
        ]
      },
      "then": {
        "properties": {
          "authoritative_source": {
            "minItems": 1
          }
        }
      }
    },
    "related_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "approved_by",
        "approved_at",
        "change_summary"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 2
        },
        "approved_at": {
          "$ref": "#/$defs/isoDate"
        },
        "change_summary": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "author_role",
          "summary"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "date": {
            "$ref": "#/$defs/isoDate"
          },
          "author_role": {
            "$ref": "#/$defs/roleEnum"
          },
          "summary": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "APPROVED"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "change_metadata",
      "revision_history"
    ],
    "properties": {
      "revision_history": {
        "minItems": 1
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
    },
    "roleEnum": {
      "type": "string",
      "enum": [
        "documentation-architect",
        "business-analyst",
        "system-architect",
        "fullstack-engineer",
        "data-architect",
        "database-architect",
        "ai-engineer",
        "security-architect",
        "qa-lead",
        "devops-sre",
        "documentation-tooling-engineer"
      ]
    }
  }
}
