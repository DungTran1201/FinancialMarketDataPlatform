# =============================================================================
# Real-time Financial Market Data Platform — Environment Configuration Template
# Copy this file to `.env` for local development. DO NOT commit `.env` to Git.
# =============================================================================

# --- Platform General ---
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=financial-market-data-platform

# --- Monitored Market Sources (Initial Baseline Scope) ---
DEFAULT_PROVIDER=binance
MONITORED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
ENABLED_STREAMS=trade,kline_1m,ticker,depth20
MARKET_STALENESS_THRESHOLD_MS=15000

# --- Binance External API (Public endpoints do not require keys; optional for higher REST weight) ---
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_BASE_URL=https://api.binance.com/api/v3
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Apache Kafka (Event Streaming Backbone — Plane A) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCER_ACKS=all
KAFKA_TOPIC_TRADES=market.raw.trades.v1
KAFKA_TOPIC_KLINES=market.raw.klines.v1
KAFKA_TOPIC_TICKERS=market.raw.tickers.v1
KAFKA_TOPIC_ORDERBOOK=market.raw.orderbook.v1
KAFKA_TOPIC_ANOMALIES=market.anomalies.v1
KAFKA_TOPIC_DLQ=market.dlq.v1

# --- Redis 7 (Hot State & Query Cache — Plane A) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_local_redis_password
REDIS_HOT_PRICE_TTL_SECONDS=300
REDIS_HOT_SNAPSHOT_TTL_SECONDS=300
REDIS_HOT_ORDERBOOK_TTL_SECONDS=120
REDIS_ANALYTICS_CACHE_TTL_SECONDS=15

# --- ClickHouse (Analytical OLAP Database — Plane A) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=market_data
# Separate least-privilege roles per architectural boundary
CLICKHOUSE_INGEST_USER=fmdp_ingest_writer
CLICKHOUSE_INGEST_PASSWORD=change_me_local_ch_ingest_password
CLICKHOUSE_API_READER_USER=fmdp_api_reader
CLICKHOUSE_API_READER_PASSWORD=change_me_local_ch_api_password
CLICKHOUSE_AGENT_RO_USER=fmdp_agent_ro
CLICKHOUSE_AGENT_RO_PASSWORD=change_me_local_ch_agent_ro_password
CLICKHOUSE_BATCH_FLUSH_INTERVAL_MS=1000
CLICKHOUSE_BATCH_MAX_ROWS=5000

# --- MinIO / S3 Object Storage & Apache Iceberg Lakehouse (Plane A) ---
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=fmdp_minio_admin
MINIO_ROOT_PASSWORD=change_me_local_minio_password
LAKEHOUSE_BUCKET=market-data
ICEBERG_CATALOG_URI=http://localhost:8181

# --- PostgreSQL 16 (Transactional Control Plane & Agent State — Plane B & C) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fmdp_control
POSTGRES_ADMIN_USER=fmdp_pg_admin
POSTGRES_ADMIN_PASSWORD=change_me_local_pg_admin_password
POSTGRES_APP_USER=fmdp_app_rw
POSTGRES_APP_PASSWORD=change_me_local_pg_app_password
POSTGRES_AGENT_USER=fmdp_agent_rw
POSTGRES_AGENT_PASSWORD=change_me_local_pg_agent_password

# --- FastAPI Backend Application (Plane B) ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change_me_generate_32_byte_random_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- LangGraph Agent Service (Intelligence Plane — Plane C) ---
# Mode 'mock' runs deterministic offline validation without external LLM calls
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=
AGENT_MAX_ITERATIONS=6
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_TOOL_TIMEOUT_SECONDS=5
AGENT_MAX_TOKENS_PER_RUN=8000
AGENT_ANOMALY_COOLDOWN_SECONDS=900

